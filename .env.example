# The Print Manager's settings for local development (cmd/printmanager):
# copy this file to .env.local (not committed) and fill it in. popcornweb
# reads .env, .env.local, .env.{APP_ENV} and .env.{APP_ENV}.local from the
# working directory.
# bearer token of the API for scripts (people sign in at the IdP)
MANAGER_ADMIN_TOKEN=
# the IdP, for go run ./cmd/printmanager (pw dev gives its own: popcornweb.toml
# [dev.idp]) and who is an admin (config.dev.toml has the dev rules)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups
OIDC_ADMINS=
# 32 bytes or more, e.g. openssl rand -hex 32
MANAGER_SECRET=
# plain http on localhost: the devices' cookie without Secure
MANAGER_SECURE_COOKIES=false
